#!/bin/bash
set -e

show_help() {
    echo "Usage: scripts/run [-b] [-d] [-f] [-r] [-x] [-n] [-v] [-s] [-o] [-h] <input_name>"
    echo "  Note: The flags -b, -d, -f, -r, and -x are mutually exclusive (you can only use one)."
    echo "  Note: You cannot use -s and -o together."
    echo "  -b    Flamegraph Mode: Profiles max-perf simulation performance using samply."
    echo "  -d    Debug Mode: Compiles and runs in debug mode."
    echo "  -f    Max-Perf Mode: Compiles and runs using the ultra-optimized max-perf profile."
    echo "  -r    Release Mode: Compiles and runs in release mode (default)."
    echo "  -x    Execute Only: Skips cargo build/run check and runs existing binary."
    echo "  -n    Headless Mode: Runs without launching a live graphical window."
    echo "  -v    Video Recording: Enables video output rendering."
    echo "  -s    Skip Particle Saving: Disables periodic particle data dumping."
    echo "  -o    Object Saving: Enables periodic object data dumping."
    echo "  -h    Show help."
    exit 0
}

PROFILE_FLAG="--release"  # Release mode is default
PROFILE_DIR="release"     # Default build directory
FLAMEGRAPH_MODE=false
EXECUTE_ONLY=false
HEADLESS=false            # Graphics enabled by default
RECORD_VIDEO=false
SAVE_PARTICLES=true
SAVE_OBJECTS=false

# Track explicit flag usage and conflicts
MODE_COUNT=0
EXPLICIT_S=false
EXPLICIT_O=false

while getopts "bdfnxvsoh" opt; do
  case $opt in
    d) 
      PROFILE_FLAG="" 
      PROFILE_DIR="debug"
      MODE_COUNT=$((MODE_COUNT + 1))
      ;;
    f) 
      PROFILE_FLAG="--profile max-perf" 
      PROFILE_DIR="max-perf"
      MODE_COUNT=$((MODE_COUNT + 1))
      ;;
    r) 
      PROFILE_FLAG="--release" 
      PROFILE_DIR="release"
      MODE_COUNT=$((MODE_COUNT + 1))
      ;;
    b) 
      FLAMEGRAPH_MODE=true 
      PROFILE_FLAG="--profile max-perf"
      PROFILE_DIR="max-perf"
      MODE_COUNT=$((MODE_COUNT + 1))
      ;;
    x) 
      EXECUTE_ONLY=true 
      MODE_COUNT=$((MODE_COUNT + 1))
      ;;
    n) HEADLESS=true ;;
    v) RECORD_VIDEO=true ;;
    s) 
      SAVE_PARTICLES=false 
      EXPLICIT_S=true
      ;;
    o) 
      SAVE_OBJECTS=true 
      EXPLICIT_O=true
      ;;
    h) show_help ;;
    \?) echo "Invalid option: -$OPTARG" >&2; exit 1 ;;
  esac
done

# Check for conflicting mode flags (-b, -d, -f, -r, -x)
if [ "$MODE_COUNT" -gt 1 ]; then
    echo "Error: Conflicting flags detected. You can only use one of [-b, -d, -f, -r, -x]." >&2
    echo "Run 'scripts/run -h' for help." >&2
    exit 1
fi

# Check for conflict between -s and -o
if [ "$EXPLICIT_S" = true ] && [ "$EXPLICIT_O" = true ]; then
    echo "Error: Conflicting output flags detected. You cannot use both -s (skip particles) and -o (save objects) together." >&2
    echo "Run 'scripts/run -h' for help." >&2
    exit 1
fi

shift $((OPTIND-1))

INPUT_NAME="$1"
if [ -z "$INPUT_NAME" ]; then
    echo "Error: No simulation name provided."
    exit 1
fi

if [[ "$INPUT_NAME" == "_"* ]]; then
    TARGET_NAME="$INPUT_NAME"
    SIM_ARG="$INPUT_NAME"
elif [[ "$INPUT_NAME" == *"_"* ]]; then
    TARGET_NAME="${INPUT_NAME%%_*}"
    SIM_ARG="$INPUT_NAME"
else
    TARGET_NAME="$INPUT_NAME"
    SIM_ARG="$INPUT_NAME"
fi

BINARY="./target/$PROFILE_DIR/$TARGET_NAME"

echo "--- Launching Simulation [Profile: $PROFILE_DIR] (Headless: $HEADLESS, Video: $RECORD_VIDEO, Save Particles: $SAVE_PARTICLES, Save Objects: $SAVE_OBJECTS) ---"

# Execute based on the selected mode
if [[ "$OSTYPE" == "linux-gnu"* ]]; then
    export GDK_BACKEND=x11
    export QT_QPA_PLATFORM=xcb
fi

if [ "$EXECUTE_ONLY" = true ]; then
    if [ ! -f "$BINARY" ]; then
        echo "Error: Binary not found at $BINARY. Build first."
        exit 1
    fi
    echo "--- Using existing binary (-x) in [$PROFILE_DIR mode] ---"
    "$BINARY" "$TARGET_NAME" "$SIM_ARG" "$HEADLESS" "$RECORD_VIDEO" "$SAVE_PARTICLES" "$SAVE_OBJECTS"
elif [ "$FLAMEGRAPH_MODE" = true ]; then
    echo "--- Launching Samply Profiler (Max-Perf Mode) ---"
    samply record cargo run $PROFILE_FLAG --bin "$TARGET_NAME" -- "$TARGET_NAME" "$SIM_ARG" "$HEADLESS" "$RECORD_VIDEO" "$SAVE_PARTICLES" "$SAVE_OBJECTS"
else
    cargo run $PROFILE_FLAG --bin "$TARGET_NAME" -- "$TARGET_NAME" "$SIM_ARG" "$HEADLESS" "$RECORD_VIDEO" "$SAVE_PARTICLES" "$SAVE_OBJECTS"
fi
