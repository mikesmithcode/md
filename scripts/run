#!/bin/bash
set -e

show_help() {
    echo "Usage: scripts/run [-b] [-r] [-x] [-h] <input_name>"
    echo "  -b    Build Release: Compiles in release mode and exits."
    echo "  -r    Release Mode: Compiles with release optimizations and runs."
    echo "  -x    Execute Only: Runs pre-existing binary without rebuilding."
    exit 0
}

RELEASE_FLAG=""
BUILD_ONLY=false
EXECUTE_ONLY=false

while getopts "brxh" opt; do
  case $opt in
    r) RELEASE_FLAG="--release" ;;
    b) BUILD_ONLY=true; RELEASE_FLAG="--release" ;;
    x) EXECUTE_ONLY=true ;;
    h) show_help ;;
    \?) echo "Invalid option: -$OPTARG" >&2; exit 1 ;;
  esac
done
shift $((OPTIND-1))

INPUT_NAME="$1"
if [ -z "$INPUT_NAME" ]; then
    echo "Error: No simulation name provided."
    exit 1
fi

if [[ "$INPUT_NAME" == "_"* ]]; then
    TARGET_NAME="$INPUT_NAME"
    SIM_ARG="$INPUT_NAME"
elif [[ "$INPUT_NAME" == *"_"* ]]; then
    TARGET_NAME="${INPUT_NAME%%_*}"
    SIM_ARG="$INPUT_NAME"
else
    TARGET_NAME="$INPUT_NAME"
    SIM_ARG="$INPUT_NAME"
fi

PROFILE_DIR=$([ "$RELEASE_FLAG" == "--release" ] && echo "release" || echo "debug")
BINARY="./target/$PROFILE_DIR/$TARGET_NAME"

if [ "$EXECUTE_ONLY" = true ]; then
    if [ ! -f "$BINARY" ]; then
        echo "Error: Binary not found at $BINARY. Build first."
        exit 1
    fi
    echo "--- Using existing binary (-x) ---"
else
    echo "--- Compiling $TARGET_NAME ${RELEASE_FLAG:-'(debug mode)'} ---"
    cargo build $RELEASE_FLAG --bin "$TARGET_NAME"
fi

if [ "$BUILD_ONLY" = true ]; then
    echo "--- Build complete ---"
    exit 0
fi

echo "--- Launching Simulation ---"
if [[ "$OSTYPE" == "linux-gnu"* ]]; then
    GDK_BACKEND=x11 QT_QPA_PLATFORM=xcb "$BINARY" "$TARGET_NAME" "$SIM_ARG"
else
    "$BINARY" "$TARGET_NAME" "$SIM_ARG"
fi